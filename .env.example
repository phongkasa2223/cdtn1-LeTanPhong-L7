# Sao chép thành .env (cp .env.example .env). KHÔNG commit file .env.
# Các giá trị dưới đây là GIÁ TRỊ MẪU để chạy thử ngay (Docker hoặc máy cá nhân). Mật khẩu và khóa mẫu ai cũng đọc được
# trong repo, nên PHẢI đổi trước khi dùng cho dữ liệu thật. Chạy trên máy cá nhân: npm run env:init thay hai giá trị đó bằng chuỗi ngẫu nhiên.
# Cơ sở dữ liệu MySQL 8.0 / MariaDB 10.4+ (xem docs/thay-doi-thiet-ke.md, mục 4)
# Khi chạy bằng Docker, docker-compose.yml ghi đè DB_HOST, DB_PORT, DB_NAME, DB_USER và PORT; chỉ DB_PASSWORD được dùng từ file này.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mekong_dq
DB_USER=mekong
DB_PASSWORD=mau-doi-mat-khau-db-truoc-khi-dung
# Số kết nối tối đa trong pool CSDL
DB_POOL_MAX=10
# Múi giờ gắn vào thời điểm đọc từ CSDL (dạng +hh:mm)
DB_TZ_OFFSET=+07:00
# Tài khoản quản trị CSDL, chỉ dùng cho npm run db:setup khi chạy ngoài Docker (tạo DB và user ứng dụng). XAMPP: root không mật khẩu. Docker không dùng.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
# Khóa ký JWT cho đăng nhập (từ 16 ký tự) và thời hạn token (giây)
JWT_SECRET=mau-doi-khoa-jwt-truoc-khi-dung-0123456789
JWT_EXPIRES_IN=3600
# Cổng chạy API khi chạy ngoài Docker
PORT=3000
# Docker: cổng trên máy chủ để mở ứng dụng (http://localhost:APP_PORT). Đổi nếu cổng 3000 đang bị chiếm.
APP_PORT=3000
# Docker: nạp dữ liệu mẫu (seeds/001_demo.sql) mỗi lần app khởi động. Đặt false để bỏ qua. Nạp lại tay: docker compose exec app npm run seed
SEED_DEMO_DATA=true
# Mức log tối thiểu: debug, info, warn hoặc error
LOG_LEVEL=info
# Tùy chọn: tên CSDL thử của test tích hợp (npm test), phải kết thúc bằng _test; mặc định là DB_NAME cộng _test (Docker và npm run db:setup đều tạo sẵn)
# TEST_DB_NAME=mekong_dq_test
# Chỉ cho npm run e2e, bỏ dấu # khi cần đổi: địa chỉ máy chủ và mật khẩu tài khoản mẫu (xem README)
# E2E_BASE_URL=http://localhost:3000
# E2E_PASSWORD=
# Chỉ khi chạy riêng giao diện bằng npm run dev --prefix frontend (đặt trong biến môi trường của shell, không đọc từ tệp .env này): địa chỉ backend để chuyển /api, và địa chỉ gốc của API khi giao diện và API khác cổng (để trống nghĩa là cùng cổng)
# VITE_BACKEND_URL=http://localhost:3000
# VITE_API_BASE=
