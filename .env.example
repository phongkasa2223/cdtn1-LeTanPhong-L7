# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# Cơ sở dữ liệu MySQL 8.0 / MariaDB 10.4+ (xem docs/thay-doi-thiet-ke.md, mục 4)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mekong_dq
DB_USER=mekong
DB_PASSWORD=
# Tài khoản quản trị CSDL, chỉ dùng cho npm run db:setup (tạo DB và user ứng dụng)
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
# Khóa ký JWT cho đăng nhập và thời hạn token (giây)
JWT_SECRET=
JWT_EXPIRES_IN=3600
# Cổng chạy API
PORT=3000
