  <diagram name="KienTruc_L7" id="arch-l7-se">
    <mxGraphModel dx="1060" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1090" pageHeight="1040" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="KIẾN TRÚC PHÂN LỚP – ỨNG DỤNG QUẢN LÝ CHẤT LƯỢNG DỮ LIỆU KHÁCH HÀNG (LUỒNG L7, TRACK SE)" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#1F3B63;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1000" height="30" as="geometry"/></mxCell>
        <mxCell id="L1" value="" style="rounded=0;html=1;fillColor=#DAE8FC;strokeColor=#1F3B63;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="760" height="140" as="geometry"/></mxCell>
        <mxCell id="L1_t" value="&lt;b&gt;1. LỚP TRÌNH BÀY – React (trình duyệt)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1F3B63;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="71" width="736" height="22" as="geometry"/></mxCell>
        <mxCell id="L1_c0" value="Nhập file khách hàng&lt;br&gt;(UC1)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="99" width="175" height="52" as="geometry"/></mxCell>
        <mxCell id="L1_c1" value="Danh sách lần nhập,&lt;br&gt;bản ghi lỗi, sửa (UC2–UC4)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="239" y="99" width="175" height="52" as="geometry"/></mxCell>
        <mxCell id="L1_c2" value="Duyệt cặp hồ sơ&lt;br&gt;nghi trùng (UC5)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="426" y="99" width="175" height="52" as="geometry"/></mxCell>
        <mxCell id="L1_c3" value="Tra cứu khách hàng,&lt;br&gt;báo cáo (UC6, UC7)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="613" y="99" width="175" height="52" as="geometry"/></mxCell>
        <mxCell id="L1_r" value="&lt;i&gt;Trách nhiệm: Hiển thị dữ liệu, nhận thao tác, hiện thông báo lỗi. KHÔNG chứa quy tắc nghiệp vụ, KHÔNG truy vấn CSDL.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="159" width="736" height="38" as="geometry"/></mxCell>
        <mxCell id="L2" value="" style="rounded=0;html=1;fillColor=#E1D5E7;strokeColor=#1F3B63;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="760" height="140" as="geometry"/></mxCell>
        <mxCell id="L2_t" value="&lt;b&gt;2. LỚP API – Express (Controller)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1F3B63;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="261" width="736" height="22" as="geometry"/></mxCell>
        <mxCell id="L2_c0" value="Middleware xác thực&lt;br&gt;và phân quyền (JWT)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="289" width="138" height="52" as="geometry"/></mxCell>
        <mxCell id="L2_c1" value="ImportController" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="202" y="289" width="138" height="52" as="geometry"/></mxCell>
        <mxCell id="L2_c2" value="RecordController" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="351" y="289" width="138" height="52" as="geometry"/></mxCell>
        <mxCell id="L2_c3" value="DuplicatePairController" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="501" y="289" width="138" height="52" as="geometry"/></mxCell>
        <mxCell id="L2_c4" value="Customer / Report&lt;br&gt;Controller" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="650" y="289" width="138" height="52" as="geometry"/></mxCell>
        <mxCell id="L2_r" value="&lt;i&gt;Trách nhiệm: Nhận request, kiểm tra định dạng đầu vào, gọi Service, đổi kết quả/lỗi thành mã HTTP (api-contract.md).&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="349" width="736" height="38" as="geometry"/></mxCell>
        <mxCell id="L3" value="" style="rounded=0;html=1;fillColor=#D5E8D4;strokeColor=#1F3B63;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="445" width="760" height="140" as="geometry"/></mxCell>
        <mxCell id="L3_t" value="&lt;b&gt;3. LỚP NGHIỆP VỤ – Service&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1F3B63;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="451" width="736" height="22" as="geometry"/></mxCell>
        <mxCell id="L3_c0" value="ImportService&lt;br&gt;(đọc CSV, mở giao dịch)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="479" width="175" height="52" as="geometry"/></mxCell>
        <mxCell id="L3_c1" value="RecordValidator&lt;br&gt;(chuẩn hóa, BR1, BR2)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="239" y="479" width="175" height="52" as="geometry"/></mxCell>
        <mxCell id="L3_c2" value="DuplicateService&lt;br&gt;(gộp / giữ riêng, BR4, BR5)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="426" y="479" width="175" height="52" as="geometry"/></mxCell>
        <mxCell id="L3_c3" value="ReportService&lt;br&gt;(tỷ lệ lỗi, FR8)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="613" y="479" width="175" height="52" as="geometry"/></mxCell>
        <mxCell id="L3_r" value="&lt;i&gt;Trách nhiệm: TOÀN BỘ quy tắc nghiệp vụ (BR1–BR7) nằm ở lớp này. Không biết dữ liệu được lưu bằng công nghệ gì.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="539" width="736" height="38" as="geometry"/></mxCell>
        <mxCell id="L4" value="" style="rounded=0;html=1;fillColor=#FFE6CC;strokeColor=#1F3B63;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="635" width="760" height="140" as="geometry"/></mxCell>
        <mxCell id="L4_t" value="&lt;b&gt;4. LỚP TRUY CẬP DỮ LIỆU – Repository&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1F3B63;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="641" width="736" height="22" as="geometry"/></mxCell>
        <mxCell id="L4_c0" value="ImportBatch&lt;br&gt;Repository" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="669" width="138" height="52" as="geometry"/></mxCell>
        <mxCell id="L4_c1" value="ImportRecord&lt;br&gt;Repository" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="202" y="669" width="138" height="52" as="geometry"/></mxCell>
        <mxCell id="L4_c2" value="Customer&lt;br&gt;Repository" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="351" y="669" width="138" height="52" as="geometry"/></mxCell>
        <mxCell id="L4_c3" value="DuplicatePair&lt;br&gt;Repository" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="501" y="669" width="138" height="52" as="geometry"/></mxCell>
        <mxCell id="L4_c4" value="AppUser&lt;br&gt;Repository" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="650" y="669" width="138" height="52" as="geometry"/></mxCell>
        <mxCell id="L4_r" value="&lt;i&gt;Trách nhiệm: Đọc/ghi dữ liệu và quản lý giao dịch; che giấu câu lệnh SQL. KHÔNG chứa quy tắc nghiệp vụ.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="729" width="736" height="38" as="geometry"/></mxCell>
        <mxCell id="db" value="&lt;b&gt;LƯU TRỮ – MySQL 8.0 (InnoDB)&lt;/b&gt;&lt;br&gt;app_user · import_batch · import_record&lt;br&gt;record_error · customer · duplicate_pair&lt;br&gt;&lt;i&gt;(chi tiết: erd.drawio)&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#F5F5F5;strokeColor=#1F3B63;strokeWidth=1.5;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="240" y="825" width="360" height="95" as="geometry"/></mxCell>
        <mxCell id="a12" value="HTTP/JSON (REST) + token Bearer – hợp đồng ở api-contract.md" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;align=left;labelBackgroundColor=none;fontFamily=Arial;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420.0" y="205" as="sourcePoint"/><mxPoint x="420.0" y="255" as="targetPoint"/><mxPoint x="12" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a23" value="Gọi hàm Service, truyền DTO; Service ném lỗi nghiệp vụ → Controller đổi thành 400/404/409" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;align=left;labelBackgroundColor=none;fontFamily=Arial;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420.0" y="395" as="sourcePoint"/><mxPoint x="420.0" y="445" as="targetPoint"/><mxPoint x="12" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a34" value="Gọi qua giao diện Repository; Service quyết định phạm vi giao dịch" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;align=left;labelBackgroundColor=none;fontFamily=Arial;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420.0" y="585" as="sourcePoint"/><mxPoint x="420.0" y="635" as="targetPoint"/><mxPoint x="12" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a4d" value="SQL (thư viện mysql2), giao dịch InnoDB" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;align=left;labelBackgroundColor=none;fontFamily=Arial;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420.0" y="775" as="sourcePoint"/><mxPoint x="420.0" y="825" as="targetPoint"/><mxPoint x="12" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="cfg" value="&lt;b&gt;File cấu hình&lt;/b&gt;&lt;br&gt;phone_prefixes.json&lt;br&gt;(danh mục đầu số di động – NFR5)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#FFF2CC;strokeColor=#B7950B;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="875" y="475" width="175" height="80" as="geometry"/></mxCell>
        <mxCell id="acfg" value="đọc khi&lt;br&gt;khởi động" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#333333;strokeWidth=1.3;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="515" as="sourcePoint"/><mxPoint x="875" y="515" as="targetPoint"/><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell>
        <mxCell id="oos" value="&lt;b&gt;NGOÀI PHẠM VI (WON’T)&lt;/b&gt;&lt;br&gt;Hệ thống bán lẻ, hệ thống bảo hành: chỉ xuất file CSV; nhân viên tải lên thủ công. Không kết nối API, không đồng bộ ngược." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F2F2F2;strokeColor=#888888;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="875" y="65" width="175" height="150" as="geometry"/></mxCell>
