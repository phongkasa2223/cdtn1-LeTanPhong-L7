        <mxCell id="as_ql_uc6" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.3;exitX=0;exitY=0.3333;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="a_ql" target="uc6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ext_uc4_uc3" value="«extend»" style="endArrow=open;endSize=11;dashed=1;html=1;strokeColor=#333333;strokeWidth=1.3;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Arial;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="uc4" target="uc3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note_rel" value="&lt;b&gt;Quan hệ «extend»&lt;/b&gt;&lt;br&gt;UC4 «extend» UC3: việc sửa CHỈ xảy ra&lt;br&gt;khi nhân viên chọn một bản ghi trong&lt;br&gt;danh sách lỗi để sửa (điểm mở rộng&lt;br&gt;“Chọn bản ghi”).&lt;br&gt;Kiểm tra và chuẩn hóa bản ghi là một&lt;br&gt;bước bên trong UC1 và UC4." style="shape=note;html=1;backgroundOutline=1;size=14;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="545" y="110" width="290" height="138" as="geometry"/></mxCell>
        <mxCell id="legend" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="700" width="700" height="150" as="geometry"/></mxCell>
        <mxCell id="legend_title" value="&lt;b&gt;CHÚ THÍCH&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="170" y="708" width="200" height="24" as="geometry"/></mxCell>
        <mxCell id="lg_assoc" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="750" as="sourcePoint"/><mxPoint x="230" y="750" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lg_assoc_t" value="Liên kết actor – use case" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="245" y="738" width="260" height="24" as="geometry"/></mxCell>
        <mxCell id="lg_note" value="" style="shape=note;html=1;backgroundOutline=1;size=8;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="522" y="737" width="36" height="26" as="geometry"/></mxCell>
        <mxCell id="lg_note_t" value="Ghi chú giải thích" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="585" y="738" width="260" height="24" as="geometry"/></mxCell>
        <mxCell id="lg_ext" value="" style="endArrow=open;endSize=11;dashed=1;html=1;strokeColor=#333333;strokeWidth=1.3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="785" as="sourcePoint"/><mxPoint x="230" y="785" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lg_ext_t" value="«extend»: mở rộng có điều kiện" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="245" y="773" width="260" height="24" as="geometry"/></mxCell>
        <mxCell id="lg_actor" value="" style="shape=umlActor;html=1;outlineConnect=0;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="532" y="770" width="16" height="30" as="geometry"/></mxCell>
        <mxCell id="lg_actor_t" value="Actor (người dùng ứng dụng)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="585" y="773" width="260" height="24" as="geometry"/></mxCell>
        <mxCell id="lg_must" value="" style="ellipse;html=1;fillColor=#DAE8FC;strokeColor=#1F3B63;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="175" y="809" width="50" height="22" as="geometry"/></mxCell>
        <mxCell id="lg_must_t" value="Use case mức MUST" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="245" y="808" width="260" height="24" as="geometry"/></mxCell>
        <mxCell id="lg_should" value="" style="ellipse;html=1;fillColor=#FFF2CC;strokeColor=#B7950B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="515" y="809" width="50" height="22" as="geometry"/></mxCell>
        <mxCell id="lg_should_t" value="Use case mức SHOULD" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="585" y="808" width="260" height="24" as="geometry"/></mxCell>
