        <mxCell id="uc4" value="&lt;b&gt;UC4&lt;/b&gt;&lt;br&gt;Sửa bản ghi lỗi" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B7950B;strokeWidth=1.5;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="560" y="320" width="240" height="80" as="geometry"/></mxCell>
