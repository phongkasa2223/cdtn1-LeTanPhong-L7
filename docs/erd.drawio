        <mxCell id="r7" value="decided_by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.3;endSize=10;startSize=10;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Arial;startArrow=ERzeroToOne;endArrow=ERmany;exitX=0.3;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="t_user" target="t_pair"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="r8" value="import_batch_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.3;endSize=10;startSize=10;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Arial;startArrow=ERmandOne;endArrow=ERmany;exitX=0.15;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="t_batch" target="t_pair"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="617.0" y="263.0"/><mxPoint x="344.0" y="263.0"/></Array></mxGeometry></mxCell>
        <mxCell id="r5" value="customer_a_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.3;endSize=10;startSize=10;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Arial;startArrow=ERmandOne;endArrow=ERmany;exitX=0.3;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="t_cust" target="t_pair"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="r6" value="customer_b_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.3;endSize=10;startSize=10;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Arial;startArrow=ERmandOne;endArrow=ERmany;exitX=0.7;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="t_cust" target="t_pair"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="r4" value="customer_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.3;endSize=10;startSize=10;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Arial;startArrow=ERzeroToOne;endArrow=ERmany;exitX=1;exitY=0.037;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.9074;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="t_cust" target="t_record"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="r9" value="merged_into_id (tự tham chiếu)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.3;endSize=10;startSize=10;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Arial;startArrow=ERzeroToOne;endArrow=ERmany;exitX=0.2;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.45;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="t_cust" target="t_cust"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="116.0" y="840"/><mxPoint x="211.0" y="840"/></Array><mxPoint x="150" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="note_idx" value="&lt;b&gt;Index, ràng buộc và quy tắc case study (QT – Bảng 9.1)&lt;/b&gt;&lt;br&gt;• UNIQUE customer(phone) → QT-01: SĐT là duy nhất; tra cứu theo SĐT (FR7). SĐT lưu dạng chuẩn 0xxxxxxxxx (QT-02)&lt;br&gt;• customer.merged_into_id → QT-13: hồ sơ bị gộp không xóa vật lý, chỉ trỏ tới hồ sơ giữ lại (FR6)&lt;br&gt;• app_user.store_code → QT-14: Nhân viên dữ liệu chỉ xem lần nhập của đơn vị mình (qua import_batch.imported_by)&lt;br&gt;• INDEX stg_customer(import_batch_id), dq_result(rule_code, stg_customer_id) → lọc bản ghi lỗi dưới 2 giây (NFR1, FR4)&lt;br&gt;• INDEX customer(email), customer(full_name, birth_date) → tìm cặp nghi trùng khác SĐT (FR2)&lt;br&gt;• INDEX duplicate_pair(status, similarity) → FR6 · INDEX import_batch(imported_at) → FR3 · không lưu giá trị tính được (FR8)&lt;br&gt;&lt;b&gt;Giá trị ENUM:&lt;/b&gt; ¹ DATA_STAFF, DATA_MANAGER · ² RETAIL, WARRANTY · ³ EMAIL, NAME_BIRTHDATE · ⁴ PENDING, MERGED, KEEP_SEPARATE ·&lt;br&gt;⁵ danh mục quy tắc dq_rule: MISSING_FIELD, PHONE_LENGTH, PHONE_PREFIX, PHONE_CHAR, EMAIL_INVALID, DATE_INVALID" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="900" height="165" as="geometry"/></mxCell>
        <mxCell id="lg" value="" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="900" height="72" as="geometry"/></mxCell>
        <mxCell id="lg_t" value="&lt;b&gt;CHÚ THÍCH&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="1066" width="120" height="20" as="geometry"/></mxCell>
        <mxCell id="lg_1" value="PK khóa chính · FK khóa ngoại · UK duy nhất · NN NOT NULL · NULL cho phép rỗng · IDX có index · AUTO tự tăng" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="180" y="1066" width="720" height="22" as="geometry"/></mxCell>
