        <mxCell id="lg_e1t" value="1 — N: bảng cha bắt buộc (FK NOT NULL)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="134" y="1098" width="300" height="24" as="geometry"/></mxCell>
        <mxCell id="lg_e2" value="" style="rounded=0;html=1;strokeColor=#333333;strokeWidth=1.3;endSize=10;startSize=10;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Arial;startArrow=ERzeroToOne;endArrow=ERmany;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="1110" as="sourcePoint"/><mxPoint x="530" y="1110" as="targetPoint"/></mxGeometry></mxCell>
