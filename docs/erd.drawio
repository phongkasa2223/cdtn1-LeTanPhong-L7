adding:1px 4px;color:#444444'&gt;VARCHAR(255)&lt;/td&gt;&lt;td style='padding:1px 6px;color:#666666;font-size:12px'&gt;NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:30px;padding:1px 6px;'&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;'&gt;birth_date&lt;/td&gt;&lt;td style='padding:1px 4px;color:#444444'&gt;DATE&lt;/td&gt;&lt;td style='padding:1px 6px;color:#666666;font-size:12px'&gt;NULL, IDX&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:30px;padding:1px 6px;'&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;'&gt;created_date&lt;/td&gt;&lt;td style='padding:1px 4px;color:#444444'&gt;DATE&lt;/td&gt;&lt;td style='padding:1px 6px;color:#666666;font-size:12px'&gt;NN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:30px;padding:1px 6px;font-weight:bold;color:#1F3B63'&gt;FK&lt;/td&gt;&lt;td style='padding:1px 4px;'&gt;merged_into_id&lt;/td&gt;&lt;td style='padding:1px 4px;color:#444444'&gt;BIGINT&lt;/td&gt;&lt;td style='padding:1px 6px;color:#666666;font-size:12px'&gt;NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:30px;padding:1px 6px;'&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;'&gt;created_at&lt;/td&gt;&lt;td style='padding:1px 4px;color:#444444'&gt;DATETIME&lt;/td&gt;&lt;td style='padding:1px 6px;color:#666666;font-size:12px'&gt;NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;verticalAlign=top;spacing=0;fillColor=#FFFFFF;strokeColor=#1F3B63;strokeWidth=1.5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="598" width="380" height="216" as="geometry"/></mxCell>
        <mxCell id="t_error" value="&lt;table style='width:100%;border-collapse:collapse;font-size:13px;font-family:Arial;text-align:left;white-space:nowrap'&gt;&lt;tr&gt;&lt;td colspan='4' style='background:#1F3B63;color:#FFFFFF;font-weight:bold;text-align:center;padding:5px 4px;font-size:14px'&gt;dq_result  (Kết quả kiểm tra – lỗi)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:30px;padding:1px 6px;font-weight:bold;color:#B7950B'&gt;PK&lt;/td&gt;&lt;td style='padding:1px 4px;font-weight:bold'&gt;dq_result_id&lt;/td&gt;&lt;td style='padding:1px 4px;color:#444444'&gt;BIGINT&lt;/td&gt;&lt;td style='padding:1px 6px;color:#666666;font-size:12px'&gt;AUTO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:30px;padding:1px 6px;font-weight:bold;color:#1F3B63'&gt;FK&lt;/td&gt;&lt;td style='padding:1px 4px;'&gt;stg_customer_id&lt;/td&gt;&lt;td style='padding:1px 4px;color:#444444'&gt;BIGINT&lt;/td&gt;&lt;td style='padding:1px 6px;color:#666666;font-size:12px'&gt;NN, IDX&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:30px;padding:1px 6px;'&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;'&gt;rule_code&lt;/td&gt;&lt;td style='padding:1px 4px;color:#444444'&gt;ENUM ⁵&lt;/td&gt;&lt;td style='padding:1px 6px;color:#666666;font-size:12px'&gt;NN, IDX&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:30px;padding:1px 6px;'&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;'&gt;field_name&lt;/td&gt;&lt;td style='padding:1px 4px;color:#444444'&gt;VARCHAR(30)&lt;/td&gt;&lt;td style='padding:1px 6px;color:#666666;font-size:12px'&gt;NN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:30px;padding:1px 6px;'&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;'&gt;message&lt;/td&gt;&lt;td style='padding:1px 4px;color:#444444'&gt;VARCHAR(255)&lt;/td&gt;&lt;td style='padding:1px 6px;color:#666666;font-size:12px'&gt;NN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:30px;padding:1px 6px;'&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;'&gt;resolved_at&lt;/td&gt;&lt;td style='padding:1px 4px;color:#444444'&gt;DATETIME&lt;/td&gt;&lt;td style='padding:1px 6px;color:#666666;font-size:12px'&gt;NULL&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;verticalAlign=top;spacing=0;fillColor=#FFFFFF;strokeColor=#1F3B63;strokeWidth=1.5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="560" y="706" width="380" height="144" as="geometry"/></mxCell>
        <mxCell id="r1" value="imported_by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.3;endSize=10;startSize=10;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Arial;startArrow=ERmandOne;endArrow=ERmany;exitX=1;exitY=0.463;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5208;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="t_user" target="t_batch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="r2" value="import_batch_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.3;endSize=10;startSize=10;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Arial;startArrow=ERmandOne;endArrow=ERmany;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="t_batch" target="t_record"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
