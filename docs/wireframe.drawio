        <mxCell id="c60" value="&lt;table style='width:100%;border-collapse:collapse;font-size:12px;font-family:Arial'&gt;&lt;tr style='background:#DAE8FC;font-weight:bold'&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;Trường&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;Hồ sơ A – C000123 (Bán lẻ)&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;Hồ sơ B – C000987 (Bảo hành)&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;Giữ giá trị&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FFF2CC;'&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;&lt;b&gt;Họ tên&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;Nguyễn Văn An&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;Nguyen Van An&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;● A &amp;nbsp; ○ B&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FFF2CC;'&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;&lt;b&gt;Số điện thoại&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;090****567&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;098****321&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;● A &amp;nbsp; ○ B&lt;/td&gt;&lt;/tr&gt;&lt;tr style=''&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;&lt;b&gt;Email&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;an.nguyen@gmail.com&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;an.nguyen@gmail.com&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr style=''&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;&lt;b&gt;Địa chỉ&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;&lt;i&gt;(trống)&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;45 Nguyễn Huệ, Q.1, TP.HCM&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;tự bổ sung từ B&lt;/td&gt;&lt;/tr&gt;&lt;tr style=''&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;&lt;b&gt;Ngày sinh&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;1990-05-12&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;1990-05-12&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr style=''&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;&lt;b&gt;Ngày tạo&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;2024-01-10&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;2025-06-02&lt;/td&gt;&lt;td style='border:1px solid #999;padding:3px'&gt;giữ ngày sớm hơn&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;html=1;overflow=fill;whiteSpace=wrap;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="54" y="984" width="870" height="158" as="geometry"/></mxCell>
        <mxCell id="c61" value="2" style="ellipse;html=1;fillColor=#F39C12;strokeColor=#B9770E;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="928" y="1010" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="c62" value="3" style="ellipse;html=1;fillColor=#F39C12;strokeColor=#B9770E;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="928" y="1056" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="c63" value="&lt;i&gt;Ô tô vàng: trường có giá trị khác nhau – bắt buộc chọn giá trị giữ lại trước khi Gộp (UC5-5a). SĐT hiển thị dạng che với Nhân viên dữ liệu (QT-15)&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="54" y="1144" width="860" height="18" as="geometry"/></mxCell>
        <mxCell id="c64" value="Hồ sơ giữ lại:" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="54" y="1166" width="110" height="26" as="geometry"/></mxCell>
